{
  "name": "flowdm",
  "version": "0.14.0",
  "description": "Cross-platform HTTP/HTTPS download manager",
  "main": "src/main.cjs",
  "private": true,
  "author": "FlowDM contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core/*.test.cjs tests/media/*.test.cjs tests/bridge/*.test.cjs tests/browser/*.test.cjs tests/tools/*.test.cjs",
    "test:coverage": "node scripts/coverage.cjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.cjs",
    "pack:win": "electron-builder --win --x64 --dir --publish=never",
    "dist:win": "electron-builder --win portable --x64 --publish=never",
    "dist:linux": "electron-builder --linux tar.gz --x64 --publish=never",
    "dist:mac": "electron-builder --mac zip --x64 --arm64 --publish=never",
    "test:native": "node scripts/test-native.cjs",
    "release:bundles": "node scripts/release-package.cjs",
    "release:verify-bundles": "node scripts/release-package.cjs --verify",
    "profile:backup": "node scripts/profile-backup.cjs"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "fflate": "0.8.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "local.flowdm.desktop",
    "productName": "FlowDM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "extension/**/*",
      "package.json"
    ],
    "asar": true,
    "afterAllArtifactBuild": "scripts/fix-linux-archive.cjs",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "vendor/media-tools",
          "to": "media-tools",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "portable": {
      "useZip": true
    }
  },
  "dependencies": {
    "basic-ftp": "6.2.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/binhhieutu/FlowDM.git"
  },
  "homepage": "https://github.com/binhhieutu/FlowDM",
  "bugs": {
    "url": "https://github.com/binhhieutu/FlowDM/issues"
  }
}
